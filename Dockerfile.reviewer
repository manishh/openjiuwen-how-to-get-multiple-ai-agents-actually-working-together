# Dockerfile.reviewer
#
# Provides a clean Python 3.12 environment so a reviewer can follow the
# tutorial steps exactly as written.  It installs only the prerequisites
# (workswarm package and pytest); it does NOT create the tutorial artifacts.
#
# Build:  docker build -f Dockerfile.reviewer -t workswarm-reviewer .
# Enter:  docker run --rm -it workswarm-reviewer bash

FROM python:3.12-slim

# System tools the tutorial's setup steps may invoke
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

# Install the WorkSwarm package (pip package name: workswarm).
# This also installs the `swarmflow` operators used in the tutorial script.
# pytest is installed so the smoke test can be run without extra steps.
RUN pip install --no-cache-dir workswarm==0.2.6 pytest

# Create a workspace directory; reviewers can mount their work here.
WORKDIR /workspace

# Default to an interactive shell so reviewers can follow along step by step.
CMD ["bash"]
